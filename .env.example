# Web/trend collection
FIRECRAWL_API_KEY=
EXA_API_KEY=
TIKHUB_API_KEY=
BILI_COOKIE=
BILI_TIMEOUT_MS=10000
# YouTube 热点走官方 Data API v3(YouTube 已下线免登录 Trending 页);留空则该平台诚实降级
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
YOUTUBE_TIMEOUT_MS=10000
YTDLP_BINARY=
VIDEO_TOOLS_PYTHON=C:/Users/Administrator/.conda/envs/py312/python.exe
YTDLP_COOKIES_PATH=
YTDLP_TIMEOUT_MS=120000

# ASR / OCR / vision providers
DASHSCOPE_API_KEY=

# LLM for trend analysis and AI planning.
# Supported: deepseek | openai | anthropic | claude-gateway | doubao-ark | gpt-gateway
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=medium
LLM_TIMEOUT_MS=45000

# Optional OpenAI-compatible GPT gateway / bmapi-style fallback.
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://bmapi.020212.xyz/v1
OPENAI_MODEL=gpt-5.5

# Optional named GPT-compatible gateway profile.
# LLM_PROVIDER=gpt-gateway
GPT_GATEWAY_API_KEY=
GPT_GATEWAY_BASE_URL=https://bmapi.020212.xyz/v1
GPT_GATEWAY_MODEL=gpt-5.5

# Optional Doubao Ark OpenAI-compatible profile.
# LLM_PROVIDER=doubao-ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6

# Optional Anthropic-compatible fallback.
# LLM_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Publishing / scheduling
POSTIZ_URL=http://127.0.0.1:5000/api
POSTIZ_API_KEY=
N8N_WEBHOOK_URL=

# Optional media providers
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# Local publishing tools
SOCIAL_AUTO_UPLOAD_HOME=
JIANYING_MCP_PATH=

# JianYing real-draft generation (pyJianYingDraft via Python)
JIANYING_PYTHON=C:/Users/Administrator/.conda/envs/py312/python.exe
JIANYING_DRAFTS_DIR=D:/JianyingPro Drafts
