# Web/trend collection
FIRECRAWL_API_KEY=
EXA_API_KEY=
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_TIMEOUT_MS=15000
# Optional endpoint overrides when TikHub changes paths.
TIKHUB_ENDPOINT_DOUYIN=/api/v1/douyin/web/fetch_hot_search_result
TIKHUB_ENDPOINT_KUAISHOU=/api/v1/kuaishou/web/fetch_kuaishou_hot_list_v2
TIKHUB_ENDPOINT_DOUYIN_SEARCH=/api/v1/douyin/app/v3/fetch_video_search_result
TIKHUB_ENDPOINT_DOUYIN_DETAIL_BY_URL=/api/v1/hybrid/video_data
TIKHUB_ENDPOINT_DOUYIN_DETAIL_BY_ID=/api/v1/douyin/app/v3/fetch_one_video
TIKHUB_ENDPOINT_DOUYIN_COMMENTS=/api/v1/douyin/app/v3/fetch_video_comments
TIKHUB_ENDPOINT_KUAISHOU_SEARCH=/api/v1/kuaishou/app/search_video_v2
TIKHUB_ENDPOINT_KUAISHOU_DETAIL_BY_URL=/api/v1/kuaishou/app/fetch_one_video_by_url
TIKHUB_ENDPOINT_KUAISHOU_DETAIL_BY_ID=/api/v1/kuaishou/app/fetch_one_video
TIKHUB_ENDPOINT_KUAISHOU_COMMENTS=/api/v1/kuaishou/app/fetch_one_video_comment
BILI_COOKIE=
BILI_TIMEOUT_MS=10000
# YouTube 热点走官方 Data API v3(YouTube 已下线免登录 Trending 页);留空则该平台诚实降级
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
YOUTUBE_TIMEOUT_MS=10000
YTDLP_BINARY=
VIDEO_TOOLS_PYTHON=C:/Users/Administrator/.conda/envs/py312/python.exe
YTDLP_COOKIES_PATH=
YTDLP_TIMEOUT_MS=120000

# ASR / OCR / vision providers
DASHSCOPE_API_KEY=

# LLM for trend analysis and AI planning.
# Supported: deepseek | openai | anthropic | claude-gateway | doubao-ark | gpt-gateway
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=medium
LLM_TIMEOUT_MS=45000

# Optional OpenAI-compatible GPT gateway / bmapi-style fallback.
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://bmapi.020212.xyz/v1
OPENAI_MODEL=gpt-5.5

# Optional named GPT-compatible gateway profile.
# LLM_PROVIDER=gpt-gateway
GPT_GATEWAY_API_KEY=
GPT_GATEWAY_BASE_URL=https://bmapi.020212.xyz/v1
GPT_GATEWAY_MODEL=gpt-5.5

# Optional Doubao Ark OpenAI-compatible profile.
# LLM_PROVIDER=doubao-ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6

# Optional Anthropic-compatible fallback.
# LLM_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Publishing / scheduling
# Default remains safe: dispatch only previews unless PUBLISH_LIVE_ENABLED=true.
PUBLISH_LIVE_ENABLED=false
# Postiz Public API base(代码会自动在末尾补 /public/v1)。
# Cloud: https://api.postiz.com ;自托管(deployments/postiz): http://localhost:5000/api
#   注意自托管要带 /api 前缀(nginx 把 /api/* 转后端;public API 实际在 /api/public/v1)。
POSTIZ_URL=https://api.postiz.com
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_ID_DOUYIN=
POSTIZ_INTEGRATION_ID_KUAISHOU=
POSTIZ_INTEGRATION_ID_BILIBILI=
POSTIZ_PLATFORM_TYPE_DOUYIN=tiktok
POSTIZ_PLATFORM_TYPE_KUAISHOU=tiktok
POSTIZ_PLATFORM_TYPE_BILIBILI=youtube
APP_BASE_URL=http://127.0.0.1:5182
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# TikTokDownloader (self-hosted, free alternative to TikHub paid endpoints)
# 提供免费抖音热榜。本项目给其 API server 补了 /douyin/hot 路由(调内部 hot.py)。
# 本机原生跑(推荐): clone JoeanAmier/TikTokDownloader → 建 venv 装 requirements →
#   把本仓 patches/ttd-douyin-hot.patch 应用到 src/application/main_server.py → python run_api.py
# 或 docker: docker run -d -p 5555:5555 joeanamier/tiktok-downloader (镜像内仍需自行加 /douyin/hot 路由)
TTD_ENABLED=false
TTD_BASE_URL=http://127.0.0.1:5555
TTD_DOUYIN_HOT_ENDPOINT=/douyin/hot
TTD_TIMEOUT_MS=60000
TTD_TOKEN=
# 抖音 Cookie:公开热榜无需;但配置后会启用 TTD 免费「搜索/评论」路径(替代 TikHub 付费接口)
TTD_DOUYIN_COOKIE=
# 可选端点覆盖(TTD 改路径时)
TTD_DOUYIN_SEARCH_ENDPOINT=/douyin/search/video
TTD_DOUYIN_COMMENT_ENDPOINT=/douyin/comment

# KS-Downloader (self-hosted, free Kuaishou detail alternative to TikHub paid endpoints)
# Start JoeanAmier/KS-Downloader API server, usually on 5557.
KSD_ENABLED=false
KSD_BASE_URL=http://127.0.0.1:5557
KSD_DETAIL_ENDPOINT=/detail/
KSD_TIMEOUT_MS=30000
KSD_COOKIE=
KSD_PROXY=

# Optional media providers
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# Local publishing tools
SOCIAL_AUTO_UPLOAD_COMMAND=social-auto-upload
SOCIAL_AUTO_UPLOAD_HOME=
SOCIAL_AUTO_UPLOAD_SESSION_DIR=
SOCIAL_AUTO_UPLOAD_CONFIG=
JIANYING_MCP_PATH=

# JianYing real-draft generation (pyJianYingDraft via Python)
JIANYING_PYTHON=C:/Users/Administrator/.conda/envs/py312/python.exe
JIANYING_DRAFTS_DIR=D:/JianyingPro Drafts
